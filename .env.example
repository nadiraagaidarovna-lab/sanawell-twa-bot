# Токен бота — выдаётся @BotFather после /newbot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Публичный URL, где будет открываться Web App (после деплоя на Render/Amvera)
# Пример: https://sanawell-bot.onrender.com
WEBAPP_URL=https://your-app.onrender.com

# Порт сервера (Render сам подставит свой PORT — эта переменная для локального запуска)
PORT=3000

# Режим бота: polling (для локальной разработки) или webhook (для продакшена)
BOT_MODE=polling

# Публичный URL сервера для webhook-режима (например https://sanawell-bot.onrender.com)
PUBLIC_URL=

# Postgres на Neon (free-тир, без карты) — Dashboard проекта → Connect → pooled connection.
# Хранилище отделено от компьюта: компьют может "засыпать" при простое (это ок, только
# задержка на реконнект), данные не теряются — в отличие от эфемерного диска Render free.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Защитный (safety) сценарий — детектор кризисных маркеров в свободном тексте (/api/safety-check).
# Список триггеров и текст сообщения (backend/src/safety.js) не утверждены гинекологом-соучредителем —
# держать false, пока она не проверит. Включать явно, не по умолчанию.
SAFETY_PROTOCOL_ENABLED=false
